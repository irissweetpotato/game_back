# Legacy single-project config. Still supported.
API_KEY=one_api_key
KEITARO_TRACKER=https://keitaro-domain.example
KEITARO_TOKEN=one_keitaro_token

# Multiple-project config, option 1: indexed variables.
# You can add any number of sets: _1, _2, _3 ... _100, etc.
API_KEY_1=api_key_for_first_app
KEITARO_TRACKER_1=https://first-keitaro.example
KEITARO_TOKEN_1=first_keitaro_token
DOMAINS_1=domain-one.example,www.domain-one.example

API_KEY_2=api_key_for_second_app
KEITARO_TRACKER_2=https://second-keitaro.example
KEITARO_TOKEN_2=second_keitaro_token
DOMAINS_2=domain-two.example,www.domain-two.example

# Multiple-project config, option 2: JSON array.
# API_CONFIGS=[{"api_key":"api_key_1","keitaro_url":"https://keitaro-1.example","keitaro_token":"token_1","domains":["domain-one.example"]},{"api_key":"api_key_2","keitaro_url":"https://keitaro-2.example","keitaro_token":"token_2"}]

# Multiple-project config, option 3: comma-separated lists.
# Counts must match.
# API_KEYS=api_key_1,api_key_2
# KEITARO_TRACKERS=https://keitaro-1.example,https://keitaro-2.example
# KEITARO_TOKENS=token_1,token_2

INSECURE_SSL=0
ALLOW_CLIENT_IP=0

# Rejected users table and web interface.
REJECTS_TABLE_FILE=./rejected_users.csv
REJECTS_ADMIN_PATH=/rejects-admin
REJECTS_ADMIN_LOGIN=admin
REJECTS_ADMIN_PASSWORD=change_this_password
REJECTS_ADMIN_COOKIE_SECRET=change_this_long_random_secret

# Telegram notifications for rejected users.
# Create a bot with @BotFather, send one message to it, then get chat_id via getUpdates.
TELEGRAM_REJECTS_ENABLED=0
TELEGRAM_REJECT_BOT_TOKEN=
TELEGRAM_REJECT_CHAT_ID=

# Optional display names for domains.
# Used in Telegram notification title and in the admin domain filter.
# JSON format is recommended:
# DOMAIN_LABELS={"domain-one.example":"First App","domain-two.example":"Second App"}
# Alternative format:
# DOMAIN_LABELS=domain-one.example=First App,domain-two.example=Second App

# If you use indexed config, you can also bind labels to every config block:
# DOMAIN_NAME_1=First App
# DOMAIN_NAME_2=Second App
